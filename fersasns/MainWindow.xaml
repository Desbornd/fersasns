<Window x:Class="fersrans.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:fersrans"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="DimGray">
    <Grid>

        <TextBlock HorizontalAlignment="Center" Margin="0,69,0,0" TextWrapping="Wrap" Text="Введите длины сторон треугольника" Foreground="LightGray" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="440,132,0,0" TextWrapping="Wrap" Text="Первая сторона" VerticalAlignment="Top" Foreground="LightGray"/>
        <TextBlock HorizontalAlignment="Left" Margin="440,175,0,0" TextWrapping="Wrap" Text="Вторая сторона" VerticalAlignment="Top" Foreground="LightGray"/>
        <TextBlock HorizontalAlignment="Left" Margin="440,218,0,0" TextWrapping="Wrap" Text="Третья сторона" VerticalAlignment="Top" Foreground="LightGray"/>
        <StackPanel>
            <TextBox HorizontalAlignment="Left" Margin="271,132,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"  x:Name="first"/>
            <TextBox HorizontalAlignment="Left" Margin="271,25,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" x:Name="second"/>
            <TextBox HorizontalAlignment="Left" Margin="271,25,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" x:Name="third"/>
            <Button Content="Рассчитать" HorizontalAlignment="Center" Margin="0,50,0,0" VerticalAlignment="Top" Background="LightGray" x:Name="but" Click="but_Click_1"/>

        </StackPanel>
    </Grid>
</Window>
